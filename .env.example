# Copy to .env and fill in your Discord token before running the bot.
DISCORD_TOKEN=

# --- HTTP API (used by AxiVale) ---
# Address embedded in keys minted by /config apikey generate. Set this to the
# URL clients should dial — e.g. your Cloudflare Tunnel hostname. Defaults to
# http://127.0.0.1:8642 (same-machine use only).
#AXITOOLS_PUBLIC_URL=https://axitools.example.com

# Bind host/port for the API server. Loopback by default; only change the host
# if clients connect directly over LAN (a tunnel like cloudflared connects
# locally, so the default is right for it).
#AXITOOLS_API_HOST=127.0.0.1
#AXITOOLS_API_PORT=8642

# The unscoped global API token (AXITOOLS_API_TOKEN / <data root>/api_token) is
# DISABLED by default in favor of per-server axt1 keys. It grants full
# cross-guild access, so enable it only for trusted same-machine automation.
# Set to 1/true/yes to opt in.
#AXITOOLS_ALLOW_GLOBAL_TOKEN=1
